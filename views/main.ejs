<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PassChecker</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0A0E12;
    --surface:#11161C;
    --border:#212932;
    --safe:#4ADE80;
    --warn:#FBBF24;
    --danger:#F87171;
    --muted:#5B6672;
  }
  body{ font-family:'Inter', sans-serif; background:var(--bg); }
  .mono{ font-family:'JetBrains Mono', monospace; }
  .caret::after{
    content:'';
    display:inline-block;
    width:2px;
    height:1em;
    background:var(--safe);
    margin-left:2px;
    vertical-align:-2px;
    animation:blink 1.1s step-end infinite;
  }
  @keyframes blink{ 50%{ opacity:0; } }
  .scan-line{
    background: repeating-linear-gradient(
      to bottom,
      transparent 0px,
      transparent 3px,
      rgba(255,255,255,0.015) 3px,
      rgba(255,255,255,0.015) 4px
    );
  }
  .glow-safe{ box-shadow: 0 0 20px -4px rgba(74,222,128,0.4); }
  .glow-warn{ box-shadow: 0 0 20px -4px rgba(251,191,36,0.4); }
  .glow-danger{ box-shadow: 0 0 20px -4px rgba(248,113,113,0.4); }
  .seg{ transition: background-color .25s ease, box-shadow .25s ease; }
  input:focus{ outline:none; }
  ::selection{ background:rgba(74,222,128,0.25); }
</style>
</head>
<body class="min-h-screen scan-line text-[#C7D0D9] flex items-center justify-center px-4 py-16">

  <div class="w-full max-w-md">

    <!-- eyebrow -->
    <div class="mono text-[11px] tracking-[0.25em] text-[#5B6672] mb-3 flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-[#4ADE80] inline-block"></span>
      SECURITY
    </div>

    <!-- window -->
    <div class="bg-[#11161C] border border-[#212932] rounded-lg overflow-hidden shadow-2xl shadow-black/40">

      <!-- title bar -->
      <div class="flex items-center gap-2 px-4 py-3 border-b border-[#212932] bg-[#0D1116]">
        <span class="w-2.5 h-2.5 rounded-full bg-[#F87171]/70"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-[#FBBF24]/70"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-[#4ADE80]/70"></span>
        <span class="mono text-[11px] text-[#5B6672] ml-2">passchecker — /check</span>
      </div>

      <div class="p-7 sm:p-8">
        <h1 class="mono text-xl font-semibold text-white mb-1.5 caret">This is the password checker page</h1>
        <p class="text-sm text-[#5B6672] mb-7 leading-relaxed">Enter a password to see how it holds up. Nothing is stored or sent anywhere.</p>

        <form method="POST" action="/check" class="space-y-4" id="checkForm">
          <div>
            <label for="password" class="mono block text-[10px] tracking-[0.2em] text-[#5B6672] mb-2">PASSWORD</label>
            <div class="relative">
              <input
                id="password"
                type="password"
                name="password"
                placeholder="Enter the password"
                autocomplete="off"
                class="mono w-full bg-[#0A0E12] border border-[#212932] rounded-md px-3.5 py-3 text-sm text-[#E7ECF1] placeholder:text-[#3C4650] focus:border-[#4ADE80]/60 transition-colors"
              >
              <button type="button" id="toggleVis" class="mono absolute right-3 top-1/2 -translate-y-1/2 text-[10px] tracking-wider text-[#5B6672] hover:text-[#C7D0D9] transition-colors">SHOW</button>
            </div>
          </div>

          <button
            type="submit"
            class="mono w-full bg-[#4ADE80] hover:bg-[#3FCB70] text-[#0A0E12] text-sm font-semibold rounded-md py-3 mt-2 transition-colors tracking-wide"
          >
            SUBMIT →
          </button>
        </form>

        <div class="flex items-center gap-3 my-6">
          <div class="h-px flex-1 bg-[#212932]"></div>
          <span class="mono text-[10px] text-[#3C4650]">OR</span>
          <div class="h-px flex-1 bg-[#212932]"></div>
        </div>

        <a href="/generate" class="mono group flex items-center justify-center gap-2 text-sm text-[#5B6672] hover:text-[#4ADE80] border border-[#212932] hover:border-[#4ADE80]/40 rounded-md py-3 transition-colors">
          Or generate a new one
          <span class="transition-transform group-hover:translate-x-0.5">↗</span>
        </a>
      </div>
    </div>

    <p class="mono text-center text-[10px] text-[#3C4650] mt-6 tracking-wide">checked locally · no data leaves this page</p>
  </div>

<script>
  const input = document.getElementById('password');
  const toggle = document.getElementById('toggleVis');
  const segs = document.querySelectorAll('[data-seg]');
  const label = document.getElementById('strengthLabel');

  toggle.addEventListener('click', () => {
    const show = input.type === 'password';
    input.type = show ? 'text' : 'password';
    toggle.textContent = show ? 'HIDE' : 'SHOW';
  });

  input.addEventListener('input', () => {
    const score = scorePassword(input.value);
    const lvl = levels[score];
    label.textContent = lvl.label;
    label.style.color = score === 0 ? '#3C4650' : lvl.color;
    segs.forEach((seg, i) => {
      seg.classList.remove('glow-safe','glow-warn','glow-danger');
      if(i < score){
        seg.style.backgroundColor = lvl.color;
        if(i === score - 1 && lvl.glow) seg.classList.add(lvl.glow);
      } else {
        seg.style.backgroundColor = '#1B2129';
      }
    });
  });
</script>
</body>
</html>