<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PassChecker — Generated</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0A0E12;
    --surface:#11161C;
    --border:#212932;
    --safe:#4ADE80;
    --warn:#FBBF24;
    --danger:#F87171;
    --info:#60A5FA;
    --muted:#5B6672;
  }
  body{ font-family:'Inter', sans-serif; background:var(--bg); }
  .mono{ font-family:'JetBrains Mono', monospace; }
  .scan-line{
    background: repeating-linear-gradient(
      to bottom,
      transparent 0px,
      transparent 3px,
      rgba(255,255,255,0.015) 3px,
      rgba(255,255,255,0.015) 4px
    );
  }
  .glow-safe{ box-shadow: 0 0 20px -4px rgba(74,222,128,0.4); }
  .glow-warn{ box-shadow: 0 0 20px -4px rgba(251,191,36,0.4); }
  .glow-danger{ box-shadow: 0 0 20px -4px rgba(248,113,113,0.4); }
  .glow-info{ box-shadow: 0 0 20px -4px rgba(96,165,250,0.4); }
  .seg{ transition: background-color .3s ease, box-shadow .3s ease; }
  .bar-fill{ transition: width .6s ease; }
  ::selection{ background:rgba(74,222,128,0.25); }
</style>
</head>
<body class="min-h-screen scan-line text-[#C7D0D9] flex items-center justify-center px-4 py-16">

  <div class="w-full max-w-md">

    <!-- eyebrow -->
    <div class="mono text-[11px] tracking-[0.25em] text-[#5B6672] mb-3 flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-[#4ADE80] inline-block"></span>
      GENERATE.RESULT
    </div>

    <!-- window -->
    <div class="bg-[#11161C] border border-[#212932] rounded-lg overflow-hidden shadow-2xl shadow-black/40">

      <!-- title bar -->
      <div class="flex items-center gap-2 px-4 py-3 border-b border-[#212932] bg-[#0D1116]">
        <span class="w-2.5 h-2.5 rounded-full bg-[#F87171]/70"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-[#FBBF24]/70"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-[#4ADE80]/70"></span>
        <span class="mono text-[11px] text-[#5B6672] ml-2">passchecker — /generate</span>
      </div>

      <div class="p-7 sm:p-8">
        <h1 class="mono text-xl font-semibold text-white mb-1.5">New password generated</h1>
        <p class="text-sm text-[#5B6672] mb-7 leading-relaxed">Copy it now — it won't be shown again.</p>

        <!-- password display -->
        <div>
          <label class="mono block text-[10px] tracking-[0.2em] text-[#5B6672] mb-2">PASSWORD</label>
          <div class="relative">
            <div
              id="passwordText"
              class="mono w-full bg-[#0A0E12] border border-[#212932] rounded-md px-3.5 py-3 pr-16 text-sm text-[#E7ECF1] break-all"
            ><%= password %></div>
            <button
              type="button"
              id="copyBtn"
              data-password="<%= password %>"
              class="mono absolute right-3 top-1/2 -translate-y-1/2 text-[10px] tracking-wider text-[#5B6672] hover:text-[#C7D0D9] transition-colors"
            >COPY</button>
          </div>
        </div>

        <!-- score bar -->
        <div class="mt-6">
          <div class="flex items-center justify-between mb-2">
            <span class="mono text-[10px] tracking-[0.2em] text-[#5B6672]">SCORE</span>
            <span class="mono text-[10px] tracking-[0.15em]" id="scoreLabel"><%= score %> / 10</span>
          </div>
          <div class="grid grid-cols-10 gap-1">
            <% for (let i = 0; i < 10; i++) { %>
              <%
                let segColor = '#1B2129';
                let segGlow = '';
                if (i < score) {
                  if (score <= 3) { segColor = '#F87171'; segGlow = 'glow-danger'; }
                  else if (score <= 6) { segColor = '#FBBF24'; segGlow = 'glow-warn'; }
                  else if (score <= 8) { segColor = '#60A5FA'; segGlow = 'glow-info'; }
                  else { segColor = '#4ADE80'; segGlow = 'glow-safe'; }
                }
                const isLast = i === score - 1;
              %>
              <div class="seg h-1.5 rounded-full <%= isLast ? segGlow : '' %>" style="background-color: <%= segColor %>;"></div>
            <% } %>
          </div>
        </div>

        <!-- entropy bar -->
        <div class="mt-6">
          <div class="flex items-center justify-between mb-2">
            <span class="mono text-[10px] tracking-[0.2em] text-[#5B6672]">ENTROPY</span>
            <span class="mono text-[10px] tracking-[0.15em] text-[#C7D0D9]"><%= entropy %> bits</span>
          </div>
          <%
            // Scale entropy to a 0–100% bar, out of a 120-bit ceiling
            let entropyPct = Math.min(100, Math.max(0, (entropy / 120) * 100));
            let entropyColor = '#F87171';
            if (entropy >= 96) entropyColor = '#4ADE80';
            else if (entropy >= 60) entropyColor = '#60A5FA';
            else if (entropy >= 34) entropyColor = '#FBBF24';
          %>
          <div class="w-full h-2 rounded-full bg-[#1B2129] overflow-hidden">
            <div
              class="bar-fill h-full rounded-full"
              style="width: <%= entropyPct %>%; background-color: <%= entropyColor %>;"
            ></div>
          </div>
        </div>

        <div class="flex items-center gap-3 my-7">
          <div class="h-px flex-1 bg-[#212932]"></div>
          <span class="mono text-[10px] text-[#3C4650]">NEXT</span>
          <div class="h-px flex-1 bg-[#212932]"></div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <a
            href="/generate"
            class="mono text-center bg-[#4ADE80] hover:bg-[#3FCB70] text-[#0A0E12] text-sm font-semibold rounded-md py-3 transition-colors tracking-wide"
          >
            GENERATE ANOTHER
          </a>
          <a
            href="/"
            class="mono text-center border border-[#212932] hover:border-[#4ADE80]/40 text-[#5B6672] hover:text-[#4ADE80] text-sm font-semibold rounded-md py-3 transition-colors tracking-wide"
          >
            BACK HOME
          </a>
        </div>
      </div>
    </div>

    <p class="mono text-center text-[10px] text-[#3C4650] mt-6 tracking-wide">generated locally · not stored on the server</p>
  </div>

<script>
  const copyBtn = document.getElementById('copyBtn');
  copyBtn.addEventListener('click', () => {
    const pw = copyBtn.getAttribute('data-password');
    navigator.clipboard.writeText(pw).then(() => {
      const original = copyBtn.textContent;
      copyBtn.textContent = 'COPIED';
      copyBtn.classList.add('text-[#4ADE80]');
      setTimeout(() => {
        copyBtn.textContent = original;
        copyBtn.classList.remove('text-[#4ADE80]');
      }, 1500);
    });
  });
</script>
</body>
</html>
